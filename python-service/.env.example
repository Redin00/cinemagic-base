# Current StreamingCommunity domain (it rotates — check before running)
SC_DOMAIN=streamingcommunityz.taxi
# Optional overrides
SC_IMAGE_CDN=https://cdn.streamingcommunityz.taxi/images
SC_CACHE_TTL=600
SC_CORS_ORIGINS=*
SC_LOG_LEVEL=INFO
# Playback embed host (also rotates — leave empty to disable playback)
SC_VIXSRC_DOMAIN=vixsrc.to
# Accounts and per-account state
# Where the SQLite file lives (defaults to python-service/data/streamapp.db)
SC_DB_PATH=
# First admin, created only when the database holds no admin yet.
# Leave the password empty to have one generated and printed to the log.
SC_ADMIN_NAME=Admin
SC_ADMIN_PASSWORD=
SC_SESSION_DAYS=30
SC_LOCKOUT_MINUTES=15
